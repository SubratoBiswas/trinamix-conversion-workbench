+    nid = await _nextpower_client_id()
+    eff = _effective_date_of(doc)
+    label = doc.get("_label") or "NXT Customer mapping (03-Aug-2026)"
+    doc_sheets = list(doc.get("_sheets") or [])
+    erp = "netsuite"
+
+    _ACTIONS = {
