# ── MongoDB ──────────────────────────────────────────────────────────────────
# Get your URI from MongoDB Atlas → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=conversion_workbench

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your Render frontend URL in production
FRONTEND_ORIGIN=http://localhost:5173

# ── AI (optional — used for mapping suggestions) ─────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── Frontend (set in frontend/.env.production for self-hosted builds) ─────────
# VITE_API_URL=https://trinamix-backend.onrender.com
