@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "reset-defaults: surface the real error instead of an opaque failure. Confirmed via the live OpenAPI that the route IS deployed, so the toast was a 500 (or the earlier 422), not a 404. Rather than keep guessing at the cause blind, wrapped the endpoint body in a try/except that returns HTTPException(400, 'Reset failed: <actual reason>') for any unexpected exception (HTTPExceptions pass through untouched), and changed the frontend catch to display the backend's detail message instead of the generic 'try again'. So the next click either works or shows exactly what broke. Kept the earlier object-derivation fix (template.business_object or conv.target_object)."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
