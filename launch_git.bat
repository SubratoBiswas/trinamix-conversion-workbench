@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Fix 'Failed to generate output' on Customer: stream sheets to bound memory. The CSV/timeout fix let the write finish fast, but generating the Customer object still built ALL 19 finalized frames in memory at once (~1200 columns x 5599 rows held simultaneously), which OOM'd the worker on Render's small instance - a 502 with no body, surfaced as the generic 'Failed to generate output'. Now the writer STREAMS: it finalizes one interface sheet, applies the linkage/sentinel glue, writes that sheet's CSV (or xlsx sheet), and releases it before the next - peak memory is ~one sheet, not nineteen. To keep parent/child linkage consistent across sheets processed independently, the per-customer reference series is computed once up front from the party sheet and shared; customer_structure_service now exposes reference_series() + apply_to_frame() for exactly this per-frame use. Verified earlier: correct Party/Account refs + sentinels + batch, and 19 sheets x 5599 rows serialize in ~0.6s."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
