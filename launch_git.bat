@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Mapping Review: let users remove wrong gold-derived defaults, then re-run AI. A constant like Country->AE gets captured when a gold file happens to hold one value in every row - correct for that client (NCR UAE), wrong for the next. Clearing it on the conversion isn't enough because the rule is stored globally and force-applied on every regenerate, so it kept coming back. New POST /conversions/{id}/reset-defaults forgets the object-level example_default rule (gold-derived by default; AI-inferred too when a specific field is targeted so a single removal actually sticks), clears the default off the conversion's mappings so the field goes blank and becomes AI/deterministic-eligible, and optionally re-runs AI in the same call. Control defaults (Import Action=CREATE, batch id, running numbers) and the metadata catalog are never touched - verified. UI: a 'Reset gold defaults' button in the mapping header does both asks at once (forget + re-run AI) with a confirm, and the per-field inspector now shows a 'Remove default' action on any field filled by a constant, for surgical fixes like just Country without disturbing the rest. Note: this is also why the precedence bar reads 'Golden record 0' - these were never golden-record MAPPINGS, they were defaults LEARNED FROM gold, which the bar counts under Default."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
