git commit -m "Prefer approved mapping per target field in output: build_converted_dataframe now dedupes MappingSuggestions per target_field_id by status priority (overridden/approved > suggested), so when a field has both an auto-map 'suggested' guess and an approved/steered mapping, the APPROVED one is used - fixes e.g. Contacts First Name showing the company name (auto-map First Name<-Legal Name) instead of the approved First Name<-First Name."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
