@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Gold Standards library: upload approved output without a project. A client-approved FBDI file is knowledge about an OBJECT ('this is what a Supplier load looks like'), not about one engagement - trapping it inside a conversion meant re-uploading it for every project. New /gold section sits beside Templates in the FBDI Library: drop in a gold file, it identifies its own template from the header overlap, and derives object-level rules written straight to the global LearnedMapping store that apply_learned_to_conversion already force-applies at generate. So gold uploaded here silently improves every conversion of that object, past and future, with zero wiring on the conversion side. Honest about what each input can teach: the gold file ALONE yields constant/near-constant defaults and the columns gold deliberately leaves blank; source->target column mappings are inferred by value-set overlap and therefore REQUIRE the paired source extract, so that upload is offered as optional and we learn fewer rules rather than guessing when it's absent. Template identification is scored against the smaller header set and verified to self-identify all 8 bundled templates at 100%, including the six near-identical supplier ones - but scoring alone let a 3-header junk file hit 67% and get filed under Supplier Address, so a match must now also clear a minimum absolute overlap (5 columns) or it comes back 'unmatched' for a human to resolve. Deleting a gold file keeps its rules by default: they may have been reviewed or reinforced by other gold files, and silently unlearning them would change every future conversion with no warning."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
