@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Gold library: capture gold uploaded on a conversion, and stop hiding the rules whose file we lost. Two real gaps. (1) The conversion-side learn-from-example endpoint wrote the upload to a temp file, learned from it, and DELETED it - the derived rules survived but the gold artefact never did. So every gold taught that way was invisible to the new library, un-downloadable, and impossible to re-learn after a rule-engine change. It now also registers a durable GoldStandard record, so gold uploaded on a conversion behaves exactly like gold uploaded to the library. It does NOT re-learn: the conversion path already learned against that conversion's source dataset (which is what lets it infer column mappings), and re-deriving would duplicate work and could disagree with what was just applied. Counts come from the *_count keys, not the lists - the lists are truncated to 60 for the API response and would have silently undercounted any large gold file. (2) For gold taught BEFORE the library existed, the file is genuinely gone and no backfill can conjure it. Rather than render those objects as if nothing was ever taught, the library now surfaces them in a 'Learned before the library existed' section: the rules are listed and honestly marked 'file not retained', with a prompt to re-upload the gold to store it. Also dedupes on (file name, object) so re-teaching a conversion replaces its library entry instead of piling up copies."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
