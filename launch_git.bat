git commit -m "Fix generate-output OOM/503 on wide datasets: build_converted_dataframe now materializes only the mapped source columns (col_cache) and restricts the per-row rule-context records to those columns, instead of caching all 200+ columns - the FBDI output was 503-ing (worker OOM) on wide extracts, including single-sheet supplier and multi-sheet customer/item."
echo Pushing...
git push origin main
echo.
