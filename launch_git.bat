@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Gold library: multi-file upload. One-at-a-time was the wrong shape - a supplier load IS six gold files, and each already identifies its own template from its headers, so there was no reason to make you do six round trips. /gold/upload now takes a list, picker is multiple + drag-drop, selected files show as a removable list, and the result comes back per file (learned / unmatched / failed) with the object and rule counts each one produced. The dialog stays open if anything came back unmatched or failed, and closes itself when everything landed clean. The source extract stays a SINGLE field shared across the batch, which is exactly the fan-out case: one legacy supplier extract is what produced all six outputs. Name and template override are hidden for a batch - each file names itself and detects its own template; upload one alone to override either. Duplicate picks (same name+size) are de-duped so choosing a file twice across two dialogs doesn't upload it twice, and one bad file no longer sinks the batch - it's reported and the rest proceed. Also guarded the BSON limit: gold bytes and source bytes both live inline in one Mongo doc capped at 16MB, and copying a large source extract alongside every file in a 6-file batch is the realistic way to blow it - so if the pair won't fit we keep the gold (the point of the record) and drop the source copy with a note. The learning already happened by then, so only re-learn is affected."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
