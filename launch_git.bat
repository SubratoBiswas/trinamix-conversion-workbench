@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Gold library: let the user correct the detected template. Header detection is good but not infallible, and a wrong template is NOT a labelling mistake - the rules that gold file taught were keyed to the wrong Oracle object, which means they have been silently applied to the wrong conversions. So editing the template can't just update a string. New PATCH /gold/{id} + repoint_gold does three things: retires what this file taught the old object, re-learns the file from its stored bytes against the new template, and re-keys everything to the new object. Retiring only happens when this was the LAST gold file behind the old object - if another gold still teaches it, those rules were earned and stay. Confidence is set to 100% on a manual repoint, because a human saying so beats header overlap. UI: the template cell is now a click-to-edit control (with a pencil on hover) plus an explicit edit action on the row; the dialog shows the detection confidence, and if you actually change the template it warns, in plain terms, that this re-derives the rules and moves them off the old object - so nobody clicks it thinking it's cosmetic. Rename is in the same dialog and does not trigger a re-learn."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
