@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Make stored gold actually apply: root cause was that learned rules only overrode still-suggested mappings, so once a conversion had AI-approved mappings the stored standard never reached the output. Fix: apply_learned_to_conversion gains force=True (overrides AI-approved suppress/default/column rules; preserves human overrides), and generate_output_artifact force-applies the object's reference standard BEFORE building every output. New POST /conversions/{id}/apply-reference-standard and /project/{id}/apply-reference-standards, plus an 'Apply gold now' button in the reference-standards banner."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
