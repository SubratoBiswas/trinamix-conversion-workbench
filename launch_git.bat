@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Learning Center: organise by OBJECT, not by row. The page was a flat registry of every rule ever captured - fine at 20 rows, useless at 978, which is exactly where it lands the moment one gold file contributes 552 'leave this column blank' rules. You could not answer the only question people actually arrive with: what does the tool know about Supplier? Now that IS the page. New /learned-mappings/by-object endpoint groups every rule by the Oracle object it applies to; each object is one expandable row showing its rule counts by type. Expand it and you get a type switcher (column mappings / default values / value crosswalks / reference standards / left blank on purpose), scoped search, per-type CSV export, and per-rule forget. Two deliberate touches: the detail view never opens on the suppression list even when that's the biggest bucket, because 500 rows of noise is not an answer; and suppressions render as compact chips with an explanation of why they exist (they are what stops the AI over-filling the file) rather than as a table nobody will read. Backend list endpoint gains target_object / q / limit filters so the UI fetches only the slice it's showing. Reference standards are no longer a separate orphan section - they show up under the object they belong to, which is where you'd look for them."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
