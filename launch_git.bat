@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Lookup code import: close the last coded-value gap. ~45 lookup types (EGP_MATERIAL_PLANNING, EGP_SOURCE_TYPES, ...) are named by the FBDI templates but their codes are configured per Fusion instance, so the tool refused to guess and passed those columns through unvalidated. Now you can import them: new OracleLookup model + /fbdi/lookups/import endpoint takes a Manage Standard Lookups export (CSV or XLSX) and writes the codes onto every FBDIField with a matching lookup_type, marked verified. Everything downstream already reads allowed_values, so those columns flip from 'unverified - passing through' to fully mapped, validated, and AI-crosswalk-eligible with no other change. Header handling is deliberately forgiving: a real Fusion export has TWO columns named Meaning (one for the lookup type, one for the code) and we resolve the one after the lookup code column, otherwise every code's meaning would come out as the lookup type's name. Disabled codes are excluded. Re-import replaces a type wholesale so retired codes actually disappear. /fbdi/lookups/status reports which types the loaded templates need vs which we hold, and the LookupImportModal shows that coverage table plus where to get the file."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
