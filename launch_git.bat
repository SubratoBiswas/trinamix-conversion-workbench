@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Learning Center KPIs: replace invented metrics with real ones. Two of the four tiles were not measuring anything. 'Avg confidence boost +26%' was the hardcoded confidence_boost=0.26 default that sits on every rule and is never changed - it would read +26% forever regardless of the data. 'Analyst time saved ~4208m' was literally total rules x 4 minutes, a made-up constant. And 'Records auto-fixed' was a real counter but mislabeled - it counts how many times a learned rule got auto-applied to a conversion FIELD, not records. Rebuilt the /stats endpoint to return only numbers computed from the data: rules captured (real), objects covered (distinct target_object), 'resolve without AI' (count of column_mapping + default + suppression + crosswalk - the rules that run deterministically with no model call, the actual payoff, shown with its % of all rules), and 'times auto-applied' (the real reuse counter, now labeled honestly). Also returns a by_source breakdown (gold / mapping workbook / metadata catalog / manual). Dropped the two fabricated fields from the schema and the strip header is now 'What the tool has learned' rather than the salesy 'Feedback loop impact'."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
