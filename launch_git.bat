@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Learning Center: import mapping workbooks. Gold makes the tool INFER the crosswalk from data; a mapping workbook STATES it - a consultant already did the mapping - so it's the strongest signal available and now has a first-class import. New /learned-mappings/import-mappings takes one or many CSV/XLSX and writes each row as a reusable column_mapping keyed by object, identical in shape to the seeded metadata catalog, so it's auto-applied on every future conversion of that object. Header detection is deliberately forgiving because consultants' mapping sheets never agree on column names: it resolves source field / target (FBDI) field / object / source system / notes by fuzzy match, and when a heading is unusual (e.g. 'NetSuite Field' / 'Fusion Field', where the system name swallows the alias) it falls back to the universal convention - source on the left, target on the right - verified across five header layouts including pure-junk which is correctly rejected. Object is taken from the file, else a user-supplied default, else inferred from the FBDI field via the loaded templates (ambiguous field names that live in two objects are refused rather than guessed). Re-importing a corrected sheet updates the existing rule instead of duplicating. Rows missing a source, target, or resolvable object are skipped and reported, never invented. UI: 'Import mappings' button + modal in the Learning Center with multi-file, drag-drop, optional default-object (autocompletes known objects) and source-system, and a per-file result showing new/updated/skipped, the objects touched, and which columns it read."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
