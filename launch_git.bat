@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Background FBDI generation: the request can no longer hit the gateway timeout. The heavy Customer object kept dying at Render's ~100s gateway (surfacing as the misleading CORS/ERR_FAILED), because generation ran inside the HTTP request. Now POST /generate-output returns IMMEDIATELY with status=generating and spawns the build as a background task; it records output_status (generating/ready/failed) + output_error on the conversion. New GET /generation-status is the poll target; it also self-heals a job stuck 'generating' >10min (worker restart/OOM) by marking it failed so the UI recovers. Status lives in Mongo, so polls are worker-agnostic. Frontend: OutputApi.generateAndWait kicks off + polls every 3s up to ~8min, returns the artifact on ready or throws the real backend error on failure; wired into Mapping Review (with live 'Generating... Ns' toast), Output Preview, Conversion Detail, and the project bulk flow. wait=true keeps the old synchronous path for the bundle build. Combined with the earlier memory cuts (skip heavy apply/capture passes, prune unmapped source columns, stream sheets), the 19-sheet Customer now builds off-thread and downloads when ready instead of erroring."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
