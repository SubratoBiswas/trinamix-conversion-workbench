@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Durable dataset source files via MongoDB GridFS: uploaded dataset extracts are stored in GridFS on upload and rehydrated to disk on read, so output generation/preview no longer 500 after a Render redeploy wipes the ephemeral disk (mirrors the template persistence fix; GridFS used because datasets can be tens of MB). Wired into output generation and dataset preview; other readers self-heal once file_path is restored."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
