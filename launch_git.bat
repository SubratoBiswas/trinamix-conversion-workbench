start "GitPush" powershell -ExecutionPolicy Bypass -NoProfile -Command "Start-Sleep 1; Write-Host 'Killing git processes...'; Get-Process git,git-remote-https -EA SilentlyContinue | Stop-Process -Force; Get-Process cmd -EA SilentlyContinue | Stop-Process -Force; Start-Sleep 3; Write-Host 'Cleaning locks...'; Remove-Item 'C:\Users\SubratoBiswas\trinamix-conversion-workbench\.git\index.lock' -Force -EA SilentlyContinue; Remove-Item 'C:\Users\SubratoBiswas\trinamix-conversion-workbench\.git\HEAD.lock' -Force -EA SilentlyContinue; Set-Location 'C:\Users\SubratoBiswas\trinamix-conversion-workbench'; Write-Host 'Dropping tracked bytecode...'; git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__; Write-Host 'Staging any stragglers...'; git add -A; Write-Host 'Committing (no-op if clean)...'; git commit -m 'Resilience: auto-retry idempotent GET requests (3x with backoff) on free-tier cold-start network errors / 502-503-504 so pages self-heal instead of crashing when the backend is waking. Writes are not retried to avoid duplicates'; Write-Host 'Pushing...'; git push origin main; Write-Host ''; Write-Host '====== DONE - Press Enter to close ======'; Read-Host"
