@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Wave V.1: make CONDITIONAL_DATE robust to both catalog config schemas + column-reference date tokens. Wave V verified fixed in output: Supplier Address/Site Inactive Date = today x372 (Inactive=Yes) / blank x7123; Supplier Site Enable B2B = Y x35 / N x7364 / blank x96, all matching source. This follow-up handles the Supplier Site Assignment Inactive Date variant, which uses the alternate schema {then_value/else_value} with then_value a COLUMN NAME ('Last Modified') rather than {value/else} with SYSDATE. Engine CONDITIONAL_DATE now: reads value from cfg['value'] or cfg['then_value'] and else from cfg['else']/['else_value']/['otherwise']; resolves a token that is SYSDATE/today/now -> today, null/None -> blank, an existing column name -> that column's date value normalised to FBDI %Y%m%d, else a literal (also normalised). So Supplier Site Assignment Inactive Date now emits the Last Modified date for inactive rows instead of today. Unit-tested both schemas; backend py_compile clean."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
