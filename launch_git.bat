@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Harden download-all zip: auto-map each conversion before generating if it has no mappings yet, so the bundle is never partial. Previously a just-created engagement whose background auto-map hadn't finished would export headers-only (0-row) files for the not-yet-mapped objects; now download-all runs mapping (which also applies the reusable learned standards) first, so every object in the zip has data regardless of download timing."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
