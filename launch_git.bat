@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Fix Customer generate HANG: skip the two DB-heavy passes for big multi-sheet objects. Watched it live: the generate-output POST stayed pending 2.5+ min while the backend answered everything else - so it was hanging, not 500-ing. Root cause: generate_output_artifact force-re-applies every learned/gold rule BEFORE writing and re-captures learnings AFTER, and for a 19-sheet Customer that's ~1200 fields => hundreds of Mongo round-trips to Atlas from a throttled free-tier instance, each generate. Neither pass changes the file that gets written: the conversion's mappings already carry the applied gold (applied at map time), and learning-capture is pure post-processing. So both are now gated on field count (>300 = heavy) and skipped for Customer/Item. Generate drops to transform + stream-write CSV (a few seconds). Light objects (Supplier etc., <300 fields) keep the full apply+capture behaviour unchanged."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
