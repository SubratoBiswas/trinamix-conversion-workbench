@echo off
echo Launching detached PowerShell git process...
start "GitPush" powershell -ExecutionPolicy Bypass -NoProfile -Command "Start-Sleep 1; Write-Host 'Killing git processes...'; Get-Process git,git-remote-https -EA SilentlyContinue | Stop-Process -Force; Get-Process cmd -EA SilentlyContinue | Stop-Process -Force; Start-Sleep 3; Write-Host 'Cleaning locks...'; Remove-Item 'C:\Users\SubratoBiswas\trinamix-conversion-workbench\.git\index.lock' -Force -EA SilentlyContinue; Remove-Item 'C:\Users\SubratoBiswas\trinamix-conversion-workbench\.git\HEAD.lock' -Force -EA SilentlyContinue; Set-Location 'C:\Users\SubratoBiswas\trinamix-conversion-workbench'; Write-Host 'Dropping tracked bytecode...'; git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__; Write-Host 'Staging any stragglers...'; git add -A; Write-Host 'Committing (no-op if clean)...'; git commit -m 'Fix very slow output generation on wide files: preview now converts only the rows it shows (was converting the entire file just to display 50), and the converter precomputes a per-column value cache + builds per-row dicts once instead of rebuilding a dict of every column for every row for every mapping via slow .iloc (was O(mappings x rows x cols)). Cuts All Vendors preview from >45s to ~1s'; Write-Host 'Pushing...'; git push origin main; Write-Host ''; Write-Host '====== DONE - Press Enter to close ======'; Read-Host"
