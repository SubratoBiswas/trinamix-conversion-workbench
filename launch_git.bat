@echo off
cd /d "C:\Users\SubratoBiswas\trinamix-conversion-workbench"
echo Cleaning any git locks...
del /f /q ".git\index.lock" 2>nul
del /f /q ".git\HEAD.lock" 2>nul
echo Dropping tracked bytecode...
git rm -r --cached --ignore-unmatch backend/app/__pycache__ backend/app/services/__pycache__ backend/app/parsers/__pycache__
echo Staging...
git add -A
echo Committing (no-op if clean)...
git commit -m "Root cause found + fixed: the real Customer Import was never loaded. Inspected the live app: BOTH customer templates in the DB are flat (business object Customer, one Import sheet, 20 fields - exactly the flat output). The real 19-sheet HZ_IMP Customer Import was never seeded, because a flat synthetic namesake already occupied the name+object and the idempotent seed SKIPPED it. So gold/AI/learnings had nothing to do with it - the target template itself was flat, and no re-point could help because no multi-sheet template existed. Fix: 'Fix Customer target' is now self-sufficient - if no >=5-sheet customer template exists, it force-seeds the real bundled CustomerImport_HZ_IMP__RA_CUSTOMER.xlsm from disk (bypassing the namesake skip), then re-points the flat-template conversions onto it and re-runs mapping. Also tightened the customer match to business_object == 'customer' exactly, so Customer Return / Credit Profile conversions are never touched. One button now: loads the real template, re-points, remaps."
echo Pushing...
git push origin main
echo.
echo ====== DONE - Press any key to close ======
pause
